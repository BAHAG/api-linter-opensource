{
  "name": "api-linter",
  "displayName": "api-linter",
  "description": "Lint api specification files",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.84.0"
  },
  "publisher": "BAHAG",
  "repository": {},
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onInstall",
    "onLanguage:yaml"
  ],
  "main": "./extension.js",
  "contributes": {
    "statusBar": [
        {
            "id": "api-linter.button",
            "text": "Activate Linter",
            "command": "api-linter.helloWorld",
            "alignment": "right",
            "tooltip": "Click to activate Api Linter"
        }
    ],
    "commands": [
        {
            "command": "api-linter.helloWorld",
            "title": "Activate Linter"
        }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.84.0",
    "@types/mocha": "^10.0.3",
    "@types/node": "18.x",
    "eslint": "^8.52.0",
    "glob": "^10.3.10",
    "mocha": "^10.2.0",
    "typescript": "^5.2.2",
    "@vscode/test-electron": "^2.3.6"
  }
}
